# 微信测试号配置 (https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login)
WECHAT_APPID=wx_your_test_appid
WECHAT_APPSECRET=your_test_appsecret
WECHAT_TOKEN=your_custom_token

# 微信模板消息模板ID（在测试号后台添加模板后获得）
WECHAT_TEMPLATE_ID=your_template_id

# 服务器配置
BASE_URL=https://your-domain.com
PORT=3000

# JWT密钥（随机字符串）
JWT_SECRET=your_random_jwt_secret

# 管理员微信 openid，多个用英文逗号分隔
ADMIN_OPENIDS=

# 新用户自动订阅的默认博主
DEFAULT_BLOGGER_SEC_UID=
DEFAULT_BLOGGER_NICKNAME=默认博主

# 轮询间隔（分钟）
POLL_INTERVAL_MINUTES=2
